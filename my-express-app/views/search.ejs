<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Applylog</title><link rel="stylesheet" href="/styles.css"></head>
<body><div class="page-shell"><header class="site-header"><a class="brand" href="/" aria-label="Applylog home"><span class="brand-mark">A</span><span>Applylog</span></a><nav class="main-nav" aria-label="Main navigation"><a class="nav-link" href="/">Applications</a><a class="nav-link active" href="/search">Search</a><a class="button button-small" href="/create">+ Add application</a></nav></header>
<main class="search-page"><div class="search-intro"><p class="eyebrow">Pipeline lookup</p><h1>Find the right <em>opportunity.</em></h1><p>Search by company, job title, reference number, platform, location, or status.</p></div><form action="/search" method="GET" class="search-bar"><label class="sr-only" for="query">Search applications</label><input type="search" name="query" id="query" placeholder="Try a company, role, or status..." value="<%= query || '' %>" autofocus><button class="button" type="submit">Search <span aria-hidden="true">→</span></button></form>
<% if (query) { %><p class="results-label">Results for <strong>“<%= query %>”</strong> <span><%= results.length %> found</span></p><% } %>
<% if (results && results.length > 0) { %><div class="results-list application-results"><% results.forEach(application => { %><article class="result-row"><span class="company-initial"><%= application.companyName.charAt(0).toUpperCase() %></span><div class="result-info"><h2><%= application.jobTitle %></h2><p class="company-name"><%= application.companyName %> · <%= application.location || "Location not set" %></p><span class="status-pill status-<%= application.status.toLowerCase().replace(/[^a-z]+/g, "-") %>"><%= application.status %></span></div><a class="card-action" href="/<%= application.id %>/update">View details <span aria-hidden="true">↗</span></a></article><% }); %></div><% } else if (query) { %><div class="empty-state search-empty"><span class="empty-icon" aria-hidden="true">?</span><h3>No applications matched that search.</h3><p>Try a different company, role, or status.</p><a class="text-link" href="/search">Clear search <span aria-hidden="true">→</span></a></div><% } else { %><div class="empty-state search-empty"><span class="empty-icon" aria-hidden="true">⌕</span><h3>Search your application tracker.</h3><p>Results will appear here when you search for an opportunity.</p></div><% } %></main>
<footer class="site-footer"><span>Applylog</span><span>Your job search, organized locally.</span></footer></div></body>
</html>
