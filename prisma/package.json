{
  "name": "prisma-file-manager",
  "version": "1.0.0",
  "description": "Express + Prisma file manager with session auth and local temporary storage",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "prisma",
    "passport",
    "multer",
    "file-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.2",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "prisma": "^5.22.0",
    "uuid": "^11.0.0"
  }
}
