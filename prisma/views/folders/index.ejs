<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f4f6fb; color: #1f2937; }
      nav { background: #111827; color: white; padding: 16px 24px; }
      nav a { color: white; text-decoration: none; margin-right: 16px; }
      main { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
      .folder { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,0.04); }
      a { color: #2563eb; text-decoration: none; }
      .flash { padding: 12px; border-radius: 8px; margin-bottom: 18px; }
      .flash.success { background: #dcfce7; color: #166534; }
      .flash.error { background: #fee2e2; color: #991b1b; }
      button { background: #dc2626; color: white; border: none; padding: 8px 12px; border-radius: 8px; cursor: pointer; }
      .small-btn { background: #2563eb; }
      .top-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/folders">Folders</a>
      <a href="/files/upload">Upload</a>
    </nav>
    <main>
      <div class="top-actions">
        <h1>Folders</h1>
        <a class="small-btn" href="/folders/new" style="background:#2563eb;color:white;padding:10px 14px;border-radius:8px;">New folder</a>
      </div>
      <% if (successFlash.length) { %>
        <% successFlash.forEach(message => { %>
          <div class="flash success"><%= message %></div>
        <% }) %>
      <% } %>
      <% if (errorFlash.length) { %>
        <% errorFlash.forEach(message => { %>
          <div class="flash error"><%= message %></div>
        <% }) %>
      <% } %>

      <div class="grid">
        <% folders.forEach(folder => { %>
          <div class="folder">
            <h3><a href="/folders/<%= folder.id %>"><%= folder.name %></a></h3>
            <p><%= folder.description || 'No description' %></p>
            <p><strong><%= folder.files.length %></strong> files</p>
            <div>
              <a href="/folders/<%= folder.id %>/edit">Edit</a>
              <form action="/folders/<%= folder.id %>?_method=DELETE" method="POST" style="display:inline; margin-left:8px;">
                <button type="submit">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
