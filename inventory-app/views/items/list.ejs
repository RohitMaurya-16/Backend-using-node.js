<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="container">
      <section class="panel">
        <div class="panel-header">
          <h1>Items</h1>
          <a href="/items/create" class="btn">Create item</a>
        </div>

        <ul class="list">
          <% items.forEach((item) => { %>
            <li>
              <a href="/items/<%= item.id %>"><%= item.name %></a>
              <span><%= item.category_name %> · Qty: <%= item.quantity %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>
  </body>
</html>
