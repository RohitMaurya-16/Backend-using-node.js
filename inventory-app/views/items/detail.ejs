<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="container">
      <section class="panel">
        <div class="panel-header">
          <h1><%= item.name %></h1>
          <div class="form-actions">
            <a href="/items/<%= item.id %>/update" class="btn">Edit</a>
          </div>
        </div>

        <div class="detail-grid">
          <div class="detail-card">
            <h3>Category</h3>
            <p><%= item.category_name %></p>
          </div>
          <div class="detail-card">
            <h3>SKU</h3>
            <p><%= item.sku %></p>
          </div>
          <div class="detail-card">
            <h3>Price</h3>
            <p>$<%= Number(item.price).toFixed(2) %></p>
          </div>
          <div class="detail-card">
            <h3>Quantity</h3>
            <p><%= item.quantity %></p>
          </div>
        </div>

        <div class="detail-card">
          <h3>Description</h3>
          <p><%= item.description || 'No description provided.' %></p>
        </div>

        <form method="POST" action="/items/<%= item.id %>/delete" class="form-actions">
          <label for="adminPassword">Admin password to delete</label>
          <input id="adminPassword" name="adminPassword" type="password" placeholder="Confirm admin password" required />
          <button type="submit" class="btn danger">Delete item</button>
        </form>
      </section>
    </main>
  </body>
</html>
