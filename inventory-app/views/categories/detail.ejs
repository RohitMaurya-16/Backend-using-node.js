<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="container">
      <section class="panel">
        <div class="panel-header">
          <h1><%= category.name %></h1>
          <div class="form-actions">
            <a href="/categories/<%= category.id %>/update" class="btn">Edit</a>
          </div>
        </div>

        <div class="detail-grid">
          <div class="detail-card">
            <h3>Description</h3>
            <p><%= category.description || 'No description provided.' %></p>
          </div>
          <div class="detail-card">
            <h3>Metadata</h3>
            <p class="meta">Created: <%= new Date(category.created_at).toLocaleDateString() %></p>
          </div>
        </div>

        <h2>Items in this category</h2>
        <% if (items.length === 0) { %>
          <p>No items in this category yet.</p>
        <% } else { %>
          <ul class="list">
            <% items.forEach((item) => { %>
              <li>
                <a href="/items/<%= item.id %>"><%= item.name %></a>
                <span>Qty: <%= item.quantity %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <form method="POST" action="/categories/<%= category.id %>/delete" class="form-actions">
          <label for="adminPassword">Admin password to delete</label>
          <input id="adminPassword" name="adminPassword" type="password" placeholder="Confirm admin password" required />
          <button type="submit" class="btn danger">Delete category</button>
        </form>
      </section>
    </main>
  </body>
</html>
